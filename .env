# Refero MCP — design references library (https://refero.design)
# Used by the Refero MCP server installed at user scope:
#   claude mcp add -s user --transport http refero https://api.refero.design/mcp --header 'Authorization: Bearer ${REFERO_BEARER_TOKEN}'
# Claude Code expands ${REFERO_BEARER_TOKEN} at runtime by reading the OS environment.
# This .env is the canonical place for the value (rotation, portability). The same value
# is also set as a Windows User env var so Claude Code's process inherits it on launch.

REFERO_BEARER_TOKEN=mcp-6H6wMsNyUDyJeH9X

# Firecrawl API key — saved 2026-05-15
FIRECRAWL_API_KEY=fc-20a643c93a3c44ee82b9a0f03ecf60d0
